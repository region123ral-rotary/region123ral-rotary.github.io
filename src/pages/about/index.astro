---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Activities from '../../components/Activities.astro';
import { LINKS } from '../../site.config.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title="委員会紹介">
  <PageHead eyebrow="About us" title="委員会紹介" />

  <section class="block">
    <div class="wrap intro">
      <div>
        <div class="block-head"><h2>どんな委員会？</h2></div>
        <p class="lead">RI理事と連携して、<mark>ローターアクトの活性化につながる「学び（ラーニング）」</mark>を全国へ届ける委員会です。</p>
        <dl class="facts">
          <div><dt>対象</dt><dd><strong>全国34地区</strong>第1・第2・第3地域、日本全国のローターアクターが対象です</dd></div>
          <div><dt>メンバー</dt><dd><strong>パスト地区RA代表</strong>地区をまとめた経験者が、現場目線で学びをつくります</dd></div>
          <div><dt>アドバイザー</dt><dd><strong>RI理事</strong>ロータリーの実態に即した、正しく質の高いラーニングを</dd></div>
        </dl>
      </div>
      <img src={base + 'img/rotary.jpg'} alt="RI理事と連携したセミナーの様子" />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="block-head"><h2>7つの活動</h2></div>
      <Activities />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="block-head"><h2>委員</h2></div>
      <ul id="members" class="members" aria-busy="true"></ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="contact">
        <h2>あなたのクラブの学びを、一緒に。</h2>
        <p>卓話のご依頼・資料のご提供・研修のご相談もお気軽にどうぞ。</p>
        <p class="contact-to">{LINKS.contactName}<br /><a href={'mailto:' + LINKS.email}>{LINKS.email}</a></p>
        <div class="contact-btns">
          <a class="btn" href={'mailto:' + LINKS.email}>メールで問い合わせる</a>
          {LINKS.instagram && <a class="btn ghost" href={LINKS.instagram} target="_blank" rel="noopener">Instagram</a>}
          {LINKS.litlink && <a class="btn ghost" href={LINKS.litlink} target="_blank" rel="noopener">各種リンク</a>}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { render } from '../../lib/sheet.js';
  import { memberItem } from '../../lib/cards.js';
  render(document.getElementById('members')!, 'members', (rows) => rows.map(memberItem).join(''));
</script>

<style>
  .intro { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center; }
  .intro img { border-radius: 18px; aspect-ratio: 4 / 3; object-fit: cover; }
  .lead { font-size: 17px; }
  mark { background: linear-gradient(transparent 60%, var(--gold-tint) 60%); color: inherit; font-weight: 700; }
  .facts { margin: 0; display: grid; gap: 10px; }
  .facts div { display: grid; grid-template-columns: 110px 1fr; gap: 16px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 18px; }
  .facts dt { color: var(--magenta); font-weight: 700; font-size: 14px; }
  .facts dd { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .facts dd strong { display: block; font-family: var(--serif); font-size: 18px; color: var(--navy); }
  @media (max-width: 800px) { .intro { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .facts div { grid-template-columns: 1fr; gap: 2px; } }

  .members { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: 14px; }
  .members :global(li) { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; display: flex; gap: 14px; align-items: flex-start; }
  .members :global(.photo) { flex: 0 0 76px; width: 76px; height: 76px; border-radius: 50%; object-fit: cover; object-position: center 25%; background: var(--paper); }
  .members :global(.noimg) { display: grid; place-items: center; background: var(--navy); color: var(--white); font-family: var(--serif); font-size: 26px; }
  .members :global(.txt) { display: flex; flex-direction: column; min-width: 0; line-height: 1.5; }
  .members :global(.role) { font-size: 12px; color: var(--magenta); font-weight: 700; }
  .members :global(strong) { font-size: 18px; color: var(--navy); }
  .members :global(.kana) { font-size: 11px; color: var(--ink-soft); }
  .members :global(.dist) { font-size: 13px; color: var(--ink); margin-top: 6px; }
  .members :global(.now) { list-style: none; padding: 0; margin: 6px 0 0; display: flex; flex-wrap: wrap; gap: 4px; }
  .members :global(.now li) { font-size: 11px; line-height: 1.4; background: var(--gold-tint); color: #7a5208; padding: 3px 8px; border-radius: 999px; }
  .members :global(.hist) { margin-top: 8px; padding-top: 6px; border-top: 1px dashed var(--line); font-size: 12px; color: var(--ink-soft); }
  .members :global(.hist summary) { cursor: pointer; color: var(--magenta); font-weight: 700; list-style: none; }
  .members :global(.hist summary::-webkit-details-marker) { display: none; }
  .members :global(.hist summary::after) { content: ' ＋'; }
  .members :global(.hist[open] summary::after) { content: ' －'; }
  .members :global(.hist ul) { margin: 6px 0 0; padding-left: 1.1em; }
  .members :global(.hist li) { margin-bottom: 2px; }
  .members :global(.desc) { font-size: 12px; color: var(--ink-soft); margin-top: 6px; padding-top: 6px; border-top: 1px dashed var(--line); }

  .contact { background: var(--navy); border-top: 6px solid var(--magenta); color: var(--white); border-radius: 20px; padding: 48px 32px; text-align: center; }
  .contact h2 { font-family: var(--serif); font-size: clamp(22px, 4vw, 32px); }
  .contact-to { font-weight: 700; }
  .contact-to a { color: var(--gold); word-break: break-all; }
  .contact-btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 8px; }
  .contact .btn:first-child { background: var(--gold); color: var(--navy); }
  .contact .btn:first-child:hover { background: var(--white); }
</style>
