---
import Layout from '../layouts/Layout.astro';
import Activities from '../components/Activities.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Rotaract Learning</p>
        <h1>全国RA<br /><em>ラーニング</em><br />委員会</h1>
        <p class="lead">ローターアクトをもっと楽しく、もっと有意義に。<br />全国のローターアクトの本質的な活性化を後押しする委員会です。</p>
        <div class="hero-btns">
          <a class="btn" href={base + 'events/'}>イベント予定を見る</a>
          <a class="btn ghost" href={base + 'about/'}>委員会について</a>
        </div>
      </div>
      <img class="hero-img" src={base + 'img/hero.jpg'} alt="第38回全国RA大会の様子" />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="block-head">
        <div><p class="eyebrow">News</p><h2>お知らせ</h2></div>
        <a class="btn-text" href={base + 'news/'}>一覧へ →</a>
      </div>
      <div id="news" class="news-list" aria-busy="true"></div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="block-head">
        <div><p class="eyebrow">Events</p><h2>これからのイベント</h2></div>
        <a class="btn-text" href={base + 'events/'}>一覧へ →</a>
      </div>
      <div id="events" class="event-list" aria-busy="true"></div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="block-head">
        <div><p class="eyebrow">What we do</p><h2>7つの活動</h2></div>
      </div>
      <Activities />
    </div>
  </section>

  <section class="block">
    <div class="wrap shortcuts">
      <a href={base + 'library/'}>
        <p class="eyebrow">Library</p>
        <strong>資料ライブラリ</strong>
        <span>研修資料・ガイドブック・アクションブックなど、すぐ使える資料をまとめています。</span>
      </a>
      <a href={base + 'cases/'}>
        <p class="eyebrow">Good Practice</p>
        <strong>全国の好事例</strong>
        <span>ロータリーとの協働、補助金の活用、クラブ文化の変革など、全国の取り組みを紹介します。</span>
      </a>
    </div>
  </section>
</Layout>

<script>
  import { render } from '../lib/sheet.js';
  import { sortNews, newsItem, splitEvents, eventItem } from '../lib/cards.js';

  render(document.getElementById('news')!, 'news', (rows) => sortNews(rows).slice(0, 4).map(newsItem).join(''));
  render(document.getElementById('events')!, 'events', (rows) => {
    const { up } = splitEvents(rows);
    return up.length ? up.slice(0, 3).map((r) => eventItem(r)).join('') : '<p class="empty">現在予定されているイベントはありません。</p>';
  });
</script>

<style>
  .hero { background: linear-gradient(135deg, #0c3c7c 0%, #0c3c7c 25%, #5a2f73 65%, #c32063 100%); color: var(--white); overflow: hidden; }
  .hero-inner { display: grid; grid-template-columns: 1fr 1.25fr; gap: 48px; align-items: center; padding: 44px 0; }
  .hero .eyebrow { color: var(--gold); }
  h1 { font-family: var(--serif); font-weight: 900; font-size: clamp(32px, 5vw, 50px); line-height: 1.2; margin: 0 0 14px; }
  h1 em { font-style: normal; color: var(--gold); }
  .lead { font-size: 16px; opacity: 0.92; word-break: auto-phrase; text-wrap: pretty; }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .hero-btns .btn:first-child { background: var(--gold); color: var(--navy); }
  .hero-btns .btn:first-child:hover { background: var(--white); }
  .hero-img { border-radius: 18px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3); aspect-ratio: 1600 / 932; object-fit: cover; }
  @media (max-width: 800px) {
    .hero-inner { grid-template-columns: 1fr; gap: 24px; padding: 32px 0; }
  }

  .shortcuts { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .shortcuts a {
    display: block; text-decoration: none; color: var(--ink); background: var(--white);
    border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; transition: 0.2s;
  }
  .shortcuts a:hover { border-color: var(--navy); box-shadow: var(--shadow); transform: translateY(-2px); }
  .shortcuts strong { display: block; font-family: var(--serif); font-size: 24px; color: var(--navy); margin-bottom: 8px; }
  .shortcuts strong::after { content: ' →'; color: var(--magenta); }
  .shortcuts span { font-size: 15px; color: var(--ink-soft); }
  @media (max-width: 700px) { .shortcuts { grid-template-columns: 1fr; } }
</style>
